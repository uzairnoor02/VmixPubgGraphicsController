    // Oldest agent build this server considers current. Leave blank to accept any version.
    // Deliberately advisory, not enforced: the dashboard warns and the log records a warning, but
    // an old agent is never refused mid-event, because turning a cosmetic version mismatch into a
    // dark broadcast is a worse outcome than running one release behind.
    "MinimumVersion": ""
  },

  // Per-tournament credentials live in state/tournaments.json, not here - they are generated,
  // rotatable and revocable per tournament from the dashboard's "Tournaments & Keys" tab. The two
  // shared secrets above remain valid for this install's own tournament so that agents already
  // deployed in the field keep working; prefer issuing per-tournament keys for anything new.
  "Tenancy": {
    // Minutes a rotated key keeps working after being replaced. A non-zero window is what makes
    // rotating safe during a live broadcast; "Revoke now" in the dashboard bypasses it.
    "RotationGraceMinutes": 45
  }
