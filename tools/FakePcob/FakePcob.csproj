<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Standalone test tool. Deliberately NOT referenced from VmixPubgGraphicsController.sln (see
    docs/testing/PHASE-1-FAKE-PCOB.md, Task 2) so it can never accidentally ship with the product
    and never needs the product's own build to succeed for `dotnet build` here to work.
    net8.0-windows + UseWindowsForms=true is only so System.Drawing.Common (used by `assets`,
    Task 8) is available in-box, with zero NuGet packages.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FakePcob</RootNamespace>
    <AssemblyName>FakePcob</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

</Project>
